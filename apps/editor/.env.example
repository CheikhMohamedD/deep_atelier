# Éditeur Deep Atelier : copier en .env.local (jamais versionné).
# Stack Supabase local : valeurs de `supabase status` (API_URL, PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# API Rust (crates/api), `cargo run -p deep-atelier-api`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
