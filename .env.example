# Deep Atelier : variables d'environnement. Copier en `.env` (jamais versionné) et compléter.

# API (crates/api) sur le stack Supabase local (`supabase start`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# API_BIND=127.0.0.1:3001
# CORS_ORIGINS=http://localhost:3000
# DATABASE_MAX_CONNECTIONS=5
# SUPABASE_JWT_ISSUER=  (par défaut : $SUPABASE_URL/auth/v1)
RUST_LOG=info,tower_http=debug

# Projet Supabase hébergé : `supabase link` et `supabase db push` lisent ces variables.
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
# L'API sur la base hébergée passe par le pooler en mode session, avec TLS :
# DATABASE_URL=postgresql://postgres.<ref>:<mot de passe>@<hôte du pooler>:5432/postgres?sslmode=require
# SUPABASE_URL=https://<ref>.supabase.co
