{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "build.mjs",
        "$TURBO_ROOT$/crates/**/*.rs",
        "$TURBO_ROOT$/crates/**/Cargo.toml",
        "$TURBO_ROOT$/crates/ir/data/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock"
      ],
      "outputs": ["pkg/**"]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    }
  }
}
