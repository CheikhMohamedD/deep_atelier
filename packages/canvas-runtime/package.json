{
  "name": "@deep-atelier/canvas-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Code de l'iframe du canvas : affiche le rendu d'une page (React, @tailwindcss/browser), mesure les éléments, répond aux tests de position, mode Preview.",
  "type": "module",
  "exports": {
    ".": "./src/render.tsx",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deep-atelier/canvas-protocol": "workspace:*",
    "@deep-atelier/ir-types": "workspace:*",
    "@tailwindcss/browser": "4.3.3",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
